# NxWitness Configuration
NX_SERVER_URL=https://evlos.ifly.it/cameras
NX_ADMIN_USERNAME=admin
NX_ADMIN_PASSWORD=your_password_here

# Detection Configuration
YOLO_MODEL=yolov8n.pt
CONFIDENCE_THRESHOLD=0.5
DEVICE=cuda:0
MIN_PERSONS_FOR_ALERT=1
ALERT_COOLDOWN_SECONDS=5

# Stream Configuration
STREAM_WIDTH=640
STREAM_HEIGHT=480
FRAME_SAMPLING=10
BATCH_SIZE=8

# Thread Configuration
MAX_CAMERAS=20
PRODUCER_THREADS=20
CONSUMER_THREADS=4
FRAME_QUEUE_SIZE=1000

# Retry Configuration
STREAM_RETRY_ATTEMPTS=3
STREAM_RETRY_DELAY=10
STREAM_RETRY_LONG_DELAY=60
ALERT_RETRY_DELAY=30
MAX_ALERT_BUFFER=1000

# Server Configuration
HOST=0.0.0.0
PORT=7002
LOG_LEVEL=INFO
LOG_DIR=logs
