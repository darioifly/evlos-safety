      "classes": [
        "person"
      ]
    },
    "ppe": {
      "path": "models/ppe/construction_safety.pt",
      "name": "PPE Detection (Construction Safety)",
      "description": "Detects helmet, vest violations with NO-Hardhat/NO-Safety Vest classes",
      "classes": [
        "Hardhat",
        "NO-Hardhat",
        "Safety Vest",
        "NO-Safety Vest",
        "Person",
        "Mask",
        "NO-Mask"
      ]
