  },
  "distanceThresholds": {
    "veryFarThreshold": 0.05,
    "farThreshold": 0.15,
    "closeThreshold": 0.3,
    "alertOnVeryFar": false,
    "alertOnFar": true,
    "alertOnClose": true
  },
  "nxWitnessAlerts": {
    "enabled": true,
    "sendEvents": true,
    "createBookmarks": true,
    "bookmarkDuration": 300
