{
  "model": "models/ppe/helmet_vest.pt",
  "modelType": "ppe",
  "confidence": 0.75,
  "device": "cuda:0",
  "minPersons": 1,
  "cooldown": 5,
  "batchSize": 4,
  "streamQuality": "highest",
  "streamWidth": 640,
  "streamHeight": 480,
  "frameSampling": 10,
  "detectionMode": "dual",
  "schedule": {
    "dayStartHour": 6,
    "dayEndHour": 18
  },
  "ppeRules": {
    "requireHelmet": true,
    "requireVest": true,
