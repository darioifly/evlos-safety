# Person Detection System - Environment Variables Example
# Copy this file to .env and customize the values

# ============================================================
# NxWitness Configuration
# ============================================================
NX_SERVER_URL=http://192.168.1.31:7001
NX_STREAM_SERVER_URL=http://192.168.1.31:7001
NX_ADMIN_USERNAME=admin
NX_ADMIN_PASSWORD=your_password_here

# ============================================================
# Detection Configuration
# ============================================================
YOLO_MODEL=yolov8n.pt
CONFIDENCE_THRESHOLD=0.5
DEVICE=cuda:0
MIN_PERSONS_FOR_ALERT=1
ALERT_COOLDOWN_SECONDS=5

# ============================================================
# EVLOS Integration (External Alert Platform)
# ============================================================
# Enable/disable EVLOS integration
EVLOS_ENABLED=false

# EVLOS API endpoint
EVLOS_API_URL=http://192.168.1.50:8000/api/v1/alerts/upload

# Request timeout (seconds)
EVLOS_TIMEOUT=10

# Max retry attempts (exponential backoff: 2s, 4s, 8s)
EVLOS_MAX_RETRIES=3

# Directory for failed alerts (local fallback)
EVLOS_FAILED_DIR=data/evlos_failed_alerts

# ============================================================
# Stream Configuration
# ============================================================
STREAM_WIDTH=640
STREAM_HEIGHT=480
FRAME_SAMPLING=30
BATCH_SIZE=4

# ============================================================
# Alert Configuration
# ============================================================
ALERT_SCREENSHOT_DIR=data/alert_screenshots
ALERT_SCREENSHOT_RETENTION_DAYS=7
ALERT_DRAW_BOXES=true
ALERT_BOOKMARK_DURATION_SECONDS=300

# ============================================================
# Server Configuration
# ============================================================
HOST=0.0.0.0
PORT=7002
LOG_LEVEL=INFO
LOG_DIR=logs
